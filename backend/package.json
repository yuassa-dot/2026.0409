{
  "name": "twstock-backend",
  "version": "1.0.0",
  "description": "Backend for Taiwan Stock Fund Screening",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "ts-node src/migrations/run.ts",
    "db:seed": "ts-node src/seeds/run.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.18.2",
    "axios": "1.6.0",
    "cheerio": "1.0.0",
    "pg": "8.10.0",
    "redis": "4.6.0",
    "node-cron": "3.0.2",
    "nodemailer": "6.9.3",
    "csv-parser": "3.0.0",
    "json2csv": "6.0.0",
    "dotenv": "16.3.1",
    "winston": "3.10.0",
    "cors": "2.8.5",
    "helmet": "7.0.0",
    "joi": "17.10.1",
    "body-parser": "1.20.2",
    "uuid": "9.0.0",
    "date-fns": "2.30.0"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/node": "20.3.1",
    "@types/jest": "29.5.2",
    "@types/uuid": "9.0.2",
    "@types/nodemailer": "6.4.8",
    "typescript": "5.1.3",
    "ts-node": "10.9.1",
    "ts-node-dev": "2.0.0",
    "jest": "29.5.0",
    "ts-jest": "29.1.0",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "eslint": "8.45.0",
    "prettier": "2.8.8"
  }
}
