# Backend
BACKEND_PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=twstock_user
DB_PASSWORD=twstock_password
DB_NAME=twstock_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@twstock.com

# Notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Crawler
CRAWLER_USER_AGENTS=Mozilla/5.0,Opera/9.80
CRAWLER_TIMEOUT=30000
CRAWLER_RETRY_COUNT=3

# Frontend
REACT_APP_API_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Application
APP_NAME=Taiwan Stock Fund Screening
APP_VERSION=1.0.0
